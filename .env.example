# OpenAI 호환 엔드포인트. 기본은 로컬 Ollama (ollama serve)
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=gemma3:4b
# Ollama는 키가 필요 없다. 키가 있는 OpenAI 호환 서비스로 바꿀 때만 넣는다.
LLM_API_KEY=

# NVIDIA Build로 바꾸려면 위 세 줄 대신 아래 주석을 푼다
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# LLM_MODEL=deepseek-ai/deepseek-v4.1-flash
# LLM_API_KEY=nvapi-...

# JSON 배열 형식. 프론트 개발 서버 주소를 넣는다.
CORS_ORIGINS=["http://localhost:5173"]
