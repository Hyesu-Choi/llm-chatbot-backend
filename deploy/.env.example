# 운영 서버(EC2)의 deploy/.env 예시. 로컬 개발용은 루트의 .env.example이다.
# 실제 값(비밀번호, JWT 키)은 여기 적지 말고 AWS SSM Parameter Store에 넣는다.

# GitHub Actions가 ECR에 올린 백엔드 이미지 주소 (계정ID · 리전은 내 것으로)
BACKEND_IMAGE=123456789012.dkr.ecr.ap-northeast-2.amazonaws.com/llm-chatbot-backend:latest

# RDS 접속 주소. RDS Postgres는 암호화 연결을 강제하므로 ?ssl=require를 붙인다
DATABASE_URL=postgresql+asyncpg://chatbot:비밀번호@xxxx.ap-northeast-2.rds.amazonaws.com:5432/chatbot?ssl=require

# openssl rand -hex 32. 로컬 .env와 다른 값을 쓴다
JWT_SECRET=

# 사용자는 CloudFront의 HTTPS 주소로 접속하므로 HTTPS 전용 쿠키로
COOKIE_SECURE=true

# 서버 메모리(8GB)에 올릴 수 있는 모델만. 이 두 모델은 ollama-pull 컨테이너가 자동으로 받는다
LLM_MODEL=gemma3:4b
EMBEDDING_MODEL=bge-m3
# 화면에서 고를 수 있는 추가 모델 없음 (exaone3.5:7.8b까지 올리면 메모리가 모자란다)
LLM_MODELS=[]

# 프론트와 API가 같은 CloudFront 주소에서 나가서(같은 출처) CORS가 필요 없다
CORS_ORIGINS=[]
